<%- include('partials/header', { title: title }) %>
<main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <header class="mb-10 flex flex-wrap items-center justify-between gap-4">
        <a class="text-2xl font-bold tracking-tight text-stone-900" href="/">Barbería PP2</a>
        <div class="flex flex-wrap items-center gap-6">
            <nav class="flex gap-4 text-sm font-medium text-stone-600" aria-label="Navegación principal">
                <a class="hover:text-amber-700" href="/">Inicio</a>
                <a class="hover:text-amber-700" href="/users">Usuarios</a>
            </nav>
            <nav class="flex gap-4 text-sm font-medium text-stone-600" aria-label="Redes sociales">
                <a class="hover:text-amber-700" href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer">Instagram</a>
                <a class="hover:text-amber-700" href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer">Facebook</a>
            </nav>
        </div>
    </header>

    <section class="mb-12 rounded-2xl bg-stone-900 px-6 py-10 text-white sm:px-10">
        <p class="mb-2 text-sm font-semibold uppercase tracking-[0.2em] text-amber-300">Sistema de turnos</p>
        <h1 class="text-3xl font-bold sm:text-5xl"><%= title %></h1>
        <p class="mt-4 max-w-2xl text-stone-300">Conocé nuestros servicios y el equipo. La reserva de turnos está disponible mediante la API.</p>
    </section>

    <section class="mb-10 rounded-xl border border-stone-200 bg-white p-4" aria-labelledby="supabase-title">
        <h2 id="supabase-title" class="font-semibold text-stone-900">Estado de Supabase</h2>
        <p class="mt-1 text-sm <%= connectionOk ? 'text-green-700' : 'text-red-700' %>" role="status">
            <%= connectionMessage %>
        </p>
        <% if (queryError) { %>
            <p class="mt-1 break-words text-sm text-red-700">Detalle: <%= queryError %></p>
        <% } %>
    </section>

    <section class="mb-12" aria-labelledby="services-title">
        <div class="mb-5 flex items-end justify-between gap-4">
            <div>
                <p class="text-sm font-semibold uppercase tracking-widest text-amber-700">Nuestra propuesta</p>
                <h2 id="services-title" class="mt-1 text-2xl font-bold text-stone-900">Servicios</h2>
            </div>
            <span class="text-sm text-stone-500"><%= services.length %> disponibles</span>
        </div>
        <% if (services.length) { %>
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
                <% services.forEach(function(service) { %>
                    <article class="flex flex-col rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
                        <h3 class="text-lg font-semibold text-stone-900"><%= service.name %></h3>
                        <p class="mt-2 flex-1 text-sm leading-6 text-stone-600"><%= service.description || 'Servicio de barbería.' %></p>
                        <div class="mt-5 flex items-center justify-between border-t border-stone-100 pt-4">
                            <span class="font-semibold text-stone-900">$<%= Number(service.price).toFixed(2) %></span>
                            <span class="text-sm text-stone-500"><%= service.duration_minutes %> min</span>
                        </div>
                    </article>
                <% }); %>
            </div>
        <% } else { %>
            <p class="rounded-xl border border-dashed border-stone-300 p-6 text-stone-600">Todavía no hay servicios activos para mostrar.</p>
        <% } %>
    </section>

    <section aria-labelledby="staff-title">
        <p class="text-sm font-semibold uppercase tracking-widest text-amber-700">Profesionales</p>
        <h2 id="staff-title" class="mb-5 mt-1 text-2xl font-bold text-stone-900">Nuestro equipo</h2>
        <% if (staff.length) { %>
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
                <% staff.forEach(function(barber) { %>
                    <article class="rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
                        <div class="mb-3 flex h-11 w-11 items-center justify-center rounded-full bg-amber-100 font-bold text-amber-800" aria-hidden="true">
                            <%= barber.full_name.charAt(0).toUpperCase() %>
                        </div>
                        <h3 class="font-semibold text-stone-900"><%= barber.full_name %></h3>
                        <p class="mt-1 text-sm text-stone-500">Barbero</p>
                    </article>
                <% }); %>
            </div>
        <% } else { %>
            <p class="rounded-xl border border-dashed border-stone-300 p-6 text-stone-600">Todavía no hay profesionales cargados.</p>
        <% } %>
    </section>
</main>
<%- include('partials/footer') %>
