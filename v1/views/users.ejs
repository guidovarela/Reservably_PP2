<%- include('partials/header', { title: title }) %>
<main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <header class="mb-8 flex flex-wrap items-center justify-between gap-4">
        <a class="text-2xl font-bold tracking-tight text-stone-900" href="/">Barbería PP2</a>
        <nav class="flex gap-4 text-sm font-medium text-stone-600" aria-label="Navegación principal">
            <a class="hover:text-amber-700" href="/">Inicio</a>
            <a class="hover:text-amber-700" href="/users" aria-current="page">Usuarios</a>
        </nav>
    </header>

    <section class="mb-8 rounded-2xl bg-stone-900 px-6 py-8 text-white sm:px-10">
        <p class="mb-2 text-sm font-semibold uppercase tracking-[0.2em] text-amber-300">Administración</p>
        <h1 class="text-3xl font-bold sm:text-4xl">Gestión de usuarios</h1>
        <p class="mt-3 text-stone-300">Administrá los datos y roles almacenados en Supabase.</p>
    </section>

    <% if (error) { %>
        <p class="mb-5 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert"><%= error %></p>
    <% } %>
    <% if (notice) { %>
        <p class="mb-5 rounded-lg border border-green-200 bg-green-50 p-4 text-sm text-green-800" role="status"><%= notice %></p>
    <% } %>

    <% if (!admin) { %>
        <section class="mx-auto max-w-lg rounded-xl border border-stone-200 bg-white p-6 shadow-sm" aria-labelledby="login-title">
            <h2 id="login-title" class="text-xl font-semibold text-stone-900">Iniciar sesión como administrador</h2>
            <% if (!authConfigured) { %>
                <p class="mt-3 text-sm text-amber-800">Configurá SUPABASE_PUBLISHABLE_KEY en el entorno del servidor para habilitar el inicio de sesión.</p>
            <% } %>
            <form class="mt-6 space-y-4" action="/users/login" method="post">
                <div>
                    <label class="mb-1 block text-sm font-medium text-stone-700" for="login-email">Email</label>
                    <input class="w-full rounded-lg border border-stone-300 px-3 py-2" id="login-email" name="email" type="email" autocomplete="username" required>
                </div>
                <div>
                    <label class="mb-1 block text-sm font-medium text-stone-700" for="login-password">Contraseña</label>
                    <input class="w-full rounded-lg border border-stone-300 px-3 py-2" id="login-password" name="password" type="password" autocomplete="current-password" required>
                </div>
                <button class="rounded-lg bg-stone-900 px-4 py-2 font-semibold text-white hover:bg-stone-700" type="submit">Ingresar</button>
            </form>
        </section>
    <% } else { %>
        <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
            <p class="text-sm text-stone-600">Sesión de <strong><%= admin.full_name %></strong> (Administrador)</p>
            <form action="/users/logout" method="post">
                <button class="rounded-lg border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-700 hover:bg-stone-100" type="submit">Cerrar sesión</button>
            </form>
        </div>

        <section class="mb-10 rounded-xl border border-stone-200 bg-white p-6 shadow-sm" aria-labelledby="create-title">
            <h2 id="create-title" class="mb-5 text-xl font-semibold text-stone-900">Dar de alta un usuario</h2>
            <p class="mb-4 text-sm text-stone-600">Para habilitar el acceso administrativo, la cuenta también debe existir en Supabase Auth con el mismo email.</p>
            <form class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4" action="/users" method="post">
                <div>
                    <label class="mb-1 block text-sm font-medium text-stone-700" for="new-full-name">Nombre completo</label>
                    <input class="w-full rounded-lg border border-stone-300 px-3 py-2" id="new-full-name" name="full_name" value="<%= formValues.full_name || '' %>" required>
                </div>
                <div>
                    <label class="mb-1 block text-sm font-medium text-stone-700" for="new-email">Email</label>
                    <input class="w-full rounded-lg border border-stone-300 px-3 py-2" id="new-email" name="email" type="email" value="<%= formValues.email || '' %>" required>
                </div>
                <div>
                    <label class="mb-1 block text-sm font-medium text-stone-700" for="new-phone">Teléfono</label>
                    <input class="w-full rounded-lg border border-stone-300 px-3 py-2" id="new-phone" name="phone" value="<%= formValues.phone || '' %>">
                </div>
                <div>
                    <label class="mb-1 block text-sm font-medium text-stone-700" for="new-role">Rol</label>
                    <select class="w-full rounded-lg border border-stone-300 px-3 py-2" id="new-role" name="role" required>
                        <option value="">Seleccioná un rol</option>
                        <option value="client" <%= formValues.role === 'client' ? 'selected' : '' %>>Cliente</option>
                        <option value="staff" <%= formValues.role === 'staff' ? 'selected' : '' %>>Staff</option>
                        <option value="admin" <%= formValues.role === 'admin' ? 'selected' : '' %>>Administrador</option>
                    </select>
                </div>
                <div class="sm:col-span-2 lg:col-span-4">
                    <button class="rounded-lg bg-amber-700 px-4 py-2 font-semibold text-white hover:bg-amber-800" type="submit">Crear usuario</button>
                </div>
            </form>
        </section>

        <section aria-labelledby="users-title">
            <div class="mb-5 flex items-end justify-between gap-4">
                <h2 id="users-title" class="text-xl font-semibold text-stone-900">Usuarios registrados</h2>
                <span class="text-sm text-stone-500"><%= users.length %> en total</span>
            </div>
            <% if (users.length) { %>
                <div class="space-y-4">
                    <% users.forEach(function(user) { %>
                        <article class="rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
                            <form class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4" id="update-<%= user.id %>" action="/users/<%= user.id %>/update" method="post">
                                <div>
                                    <label class="mb-1 block text-sm font-medium text-stone-700" for="name-<%= user.id %>">Nombre completo</label>
                                    <input class="w-full rounded-lg border border-stone-300 px-3 py-2" id="name-<%= user.id %>" name="full_name" value="<%= user.full_name %>" required>
                                </div>
                                <div>
                                    <label class="mb-1 block text-sm font-medium text-stone-700" for="email-<%= user.id %>">Email</label>
                                    <input class="w-full rounded-lg border border-stone-300 px-3 py-2" id="email-<%= user.id %>" name="email" type="email" value="<%= user.email %>" required>
                                </div>
                                <div>
                                    <label class="mb-1 block text-sm font-medium text-stone-700" for="phone-<%= user.id %>">Teléfono</label>
                                    <input class="w-full rounded-lg border border-stone-300 px-3 py-2" id="phone-<%= user.id %>" name="phone" value="<%= user.phone || '' %>">
                                </div>
                                <div>
                                    <label class="mb-1 block text-sm font-medium text-stone-700" for="role-<%= user.id %>">Rol</label>
                                    <select class="w-full rounded-lg border border-stone-300 px-3 py-2" id="role-<%= user.id %>" name="role" required>
                                        <option value="client" <%= user.role === 'client' ? 'selected' : '' %>>Cliente</option>
                                        <option value="staff" <%= user.role === 'staff' ? 'selected' : '' %>>Staff</option>
                                        <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Administrador</option>
                                    </select>
                                </div>
                                <div class="flex flex-wrap gap-3 sm:col-span-2 lg:col-span-4">
                                    <button class="rounded-lg bg-stone-900 px-4 py-2 text-sm font-semibold text-white hover:bg-stone-700" type="submit">Guardar cambios</button>
                                </div>
                            </form>
                            <form class="mt-3 border-t border-stone-100 pt-3" action="/users/<%= user.id %>/delete" method="post">
                                <button class="rounded-lg border border-red-300 px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50" type="submit">Dar de baja</button>
                            </form>
                        </article>
                    <% }); %>
                </div>
            <% } else { %>
                <p class="rounded-xl border border-dashed border-stone-300 p-6 text-stone-600">Todavía no hay usuarios cargados.</p>
            <% } %>
        </section>
    <% } %>
</main>
<%- include('partials/footer') %>
